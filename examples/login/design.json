{
  "schemaVersion": "0.1",
  "id": "login-proposal",
  "title": "登録・ログイン：比較提案 / Registration and login",
  "language": "ja",
  "stage": "finalize",
  "revision": 2,
  "mode": "standard",
  "comparisonAxes": [
    "入力負担",
    "復旧しやすさ",
    "端末・メールへの依存",
    "実現可能性"
  ],
  "risks": [
    "サンプルはAIが作成した設計提案。人間による採用・意味的整合性レビューは未実施。",
    "実際の認証、メール配信、端末適合性、支援技術、実ユーザーでの効果は未検証。",
    "コピー・画面構成は仮説。SVGの静的配置はレスポンシブ実装ではない。"
  ],
  "budget": {
    "maxCandidates": 5,
    "maxToolCalls": null,
    "toolCallsUsed": null,
    "exhausted": false
  },
  "requirements": [
    {
      "id": "req-access",
      "text": "新規登録と再ログインが可能な設計を比較する",
      "source": "benchmarks/level-1.json",
      "priority": "must"
    },
    {
      "id": "req-recover",
      "text": "エラーから復旧する導線を説明する",
      "source": "MVP registration/login slice",
      "priority": "must"
    }
  ],
  "assumptions": [
    {
      "id": "assumption-password",
      "text": "既存ユーザーはパスワード方式に慣れている",
      "status": "unverified",
      "evidenceIds": []
    },
    {
      "id": "assumption-email",
      "text": "利用中の端末でメールにアクセスできる",
      "status": "unverified",
      "evidenceIds": []
    }
  ],
  "constraints": [
    {
      "id": "constraint-access",
      "text": "必須操作のラベルとキーボード操作・可視フォーカスを設計に含める",
      "kind": "hard",
      "source": "DIF proposal accessibility baseline",
      "conflictsWith": []
    }
  ],
  "candidates": [
    {
      "id": "candidate-a",
      "name": "A — Familiar form",
      "approach": "conventional",
      "status": "shortlisted",
      "rationale": "登録とログインを分離し、馴染みのあるメール・パスワード入力を優先。",
      "assumptionIds": [
        "assumption-password"
      ],
      "requirementIds": [
        "req-access",
        "req-recover"
      ],
      "parentIds": [],
      "differences": [
        "Aは登録/ログインを分離、Bはメールから共通開始",
        "Aはパスワード、Bはメール確認を中心に設計"
      ],
      "tradeoffs": [
        "パスワード管理負担",
        "既存の認証基盤へ適合しやすい"
      ],
      "constraintChecks": [
        {
          "constraintId": "constraint-access",
          "result": "pass",
          "rationale": "仕様上のラベル/キーボード/フォーカス設計を確認。実装適合は未検証。",
          "evidenceIds": [
            "ev-declarations"
          ]
        }
      ]
    },
    {
      "id": "candidate-b",
      "name": "B — Email-first guided access",
      "approach": "innovative",
      "status": "shortlisted",
      "rationale": "メール入力を起点に登録と再訪を案内する段階式導線。新規性は本比較内の相対評価。",
      "assumptionIds": [
        "assumption-email"
      ],
      "requirementIds": [
        "req-access",
        "req-recover"
      ],
      "parentIds": [],
      "differences": [
        "Aは登録/ログインを分離、Bはメールから共通開始",
        "Aはパスワード、Bはメール確認を中心に設計"
      ],
      "tradeoffs": [
        "メール到達と別画面への移動に依存",
        "パスワード入力負担を減らす可能性は未検証"
      ],
      "constraintChecks": [
        {
          "constraintId": "constraint-access",
          "result": "pass",
          "rationale": "仕様上のラベル/キーボード/フォーカス設計を確認。実装適合は未検証。",
          "evidenceIds": [
            "ev-declarations"
          ]
        }
      ]
    }
  ],
